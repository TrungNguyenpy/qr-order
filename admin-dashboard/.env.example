# Địa chỉ Backend API (không có dấu / ở cuối). Docker compose mặc định: http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8081

# STOMP/WebSocket (sơ đồ bàn realtime). Khuyến nghị WebSocket thuần: ws://<host>/ws/websocket
# (cũng chấp nhận http(s)://<host>/ws - sẽ tự đổi sang ws(s)://<host>/ws/websocket).
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws/websocket

# Giới hạn ảnh món phía client (MB), khớp MENU_IMAGE_MAX_SIZE của backend (mặc định 5). Backend vẫn là nguồn quyết định.
NEXT_PUBLIC_MAX_IMAGE_SIZE_MB=5
