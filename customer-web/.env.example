# Địa chỉ gốc của Backend API (không có "/" cuối, không gồm /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Endpoint STOMP của backend.
#  - http(s)://host/ws            -> dùng SockJS (mặc định của backend)
#  - ws(s)://host/ws/websocket    -> dùng WebSocket thuần
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# (Tùy chọn) Giới hạn số lượng mỗi dòng ở phía client. Server vẫn là nguồn quyết định
# (restaurant_settings.max_item_quantity, mặc định 99).
NEXT_PUBLIC_MAX_ITEM_QUANTITY=99
