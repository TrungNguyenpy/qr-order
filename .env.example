# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
SPRING_PROFILES_ACTIVE=dev

DB_NAME=qr_order
DB_USERNAME=qr_order
DB_PASSWORD=
DB_PORT=5432

# Khóa HMAC cho JWT: Base64 của >= 32 byte ngẫu nhiên. Sinh bằng:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=qr-order
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

# Origin của Customer Web / Admin Dashboard, phân tách bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ADMIN đầu tiên (chỉ dùng khi database chưa có user nào). Mật khẩu: >= 8 ký tự, có chữ hoa, chữ thường, chữ số.
# Sau lần khởi động đầu tiên và đăng nhập thành công, nên xóa INITIAL_ADMIN_PASSWORD khỏi .env.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=

# Cloudinary - lưu ảnh món (Giai đoạn 2). Để trống thì API upload ảnh trả 503, các API khác vẫn chạy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=qr-order/products
# Dung lượng ảnh món tối đa (mặc định 5MB)
MENU_IMAGE_MAX_SIZE=5MB

# QR bàn (Giai đoạn 3). URL trên QR = QR_BASE_URL + /t/ + qrToken (QR_BASE_URL = địa chỉ Customer Web, không có "/" cuối).
# QR_TOKEN_SECRET: Base64 của >= 32 byte ngẫu nhiên, sinh bằng:  openssl rand -base64 48
# Dùng để in lại QR (DB chỉ lưu SHA-256 của token). Để trống: API sinh/xoay/in QR trả 503, khách vẫn join bằng QR đã có.
QR_BASE_URL=http://localhost:3000
QR_TOKEN_SECRET=
# Chu kỳ quét phiên idle (EXPIRED / needs_attention), mili giây (mặc định 1 phút)
SESSION_EXPIRY_CHECK_INTERVAL_MS=60000

# Phiếu thanh toán nội bộ (Giai đoạn 5a, FR-PAY-12) - thông tin in đầu/cuối phiếu. Để trống thì phiếu không có dòng đó.
RECEIPT_RESTAURANT_NAME=
RECEIPT_ADDRESS=
RECEIPT_PHONE=
RECEIPT_TAX_CODE=
RECEIPT_FOOTER=Phiếu thanh toán nội bộ - không thay thế hóa đơn điện tử

# VietQR (thu ngân xác nhận tay). Tài khoản nhận tiền cấu hình ở Admin Dashboard > Cấu hình.
VIETQR_IMAGE_BASE_URL=https://img.vietqr.io/image
VIETQR_TEMPLATE=compact2

SERVER_PORT=8080
OPENAPI_ENABLED=false

# --- Giai đoạn 6: báo cáo (BE-34). Các ca làm việc cấu hình trong application.yml (app.report.shifts).
# Khoảng from/to tối đa của API báo cáo, tính bằng ngày.
REPORT_MAX_RANGE_DAYS=366
